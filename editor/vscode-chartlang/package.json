{
  "name": "chartlang",
  "displayName": "ChartLang (qana demo)",
  "description": "Demo language served by the qana incremental toolchain: semantic highlighting with deltas, diagnostics from repair, outline, folding, completion, and live grammar hot-reload via chartlang.rg — with .rg grammar files themselves served by the same engine.",
  "version": "0.0.1",
  "publisher": "qana",
  "private": true,
  "engines": { "vscode": "^1.85.0" },
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "chartlang",
        "extensions": [".cl"],
        "aliases": ["ChartLang"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "qana-grammar",
        "extensions": [".rg"],
        "aliases": ["qana grammar"],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "ChartLang",
      "properties": {
        "chartlang.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the qana-lsp binary (defaults to `qana-lsp` on PATH, or target/release/qana-lsp in the workspace)."
        }
      }
    },
    "semanticTokenScopes": [
      {
        "language": "chartlang",
        "scopes": {
          "keyword": ["keyword.control.chartlang"],
          "variable": ["variable.other.chartlang"],
          "number": ["constant.numeric.chartlang"],
          "string": ["string.quoted.double.chartlang"],
          "comment": ["comment.line.chartlang"],
          "operator": ["keyword.operator.chartlang"],
          "punctuation": ["punctuation.separator.chartlang"],
          "bracket": ["punctuation.bracket.chartlang"],
          "regexp": ["string.regexp.chartlang"]
        }
      },
      {
        "language": "qana-grammar",
        "scopes": {
          "keyword": ["keyword.control.rg"],
          "variable": ["variable.other.rg"],
          "number": ["constant.numeric.rg"],
          "string": ["string.quoted.double.rg"],
          "comment": ["comment.line.rg"],
          "operator": ["keyword.operator.rg"],
          "punctuation": ["punctuation.separator.rg"],
          "bracket": ["punctuation.bracket.rg"],
          "regexp": ["string.regexp.rg"]
        }
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}

// Rust: its syntax, over the lexical grammar of `../rust-lex/rust_lex.qana`.
//
// It cuts every line into exactly the tokens rust_lex.qana does, in the
// same modes, so what was measured there against rustc's own lexer holds
// here (crates/qana-lang/tests/rust.rs checks that it does). Which token a
// piece of text is can differ: keywords are tokens of their own, and so is
// each kind of punctuation. Over those tokens it is Rust's syntax as the
// Rust Reference gives it, edition 2021, with what later releases made
// stable (let chains, `&raw`, `unsafe extern`, `use<..>` bounds, async
// closures), as one deterministic LR(1) grammar: every choice below is
// rustc's own, made with one token of lookahead.
//
// THE PUNCTUATION. rustc_lexer cuts punctuation one character at a time,
// and the parser joins `>>`, `..=` and the rest. Joining needs to see past
// one token: `>` alone, `>` before `>`, `>` before `=` and `>` before `>=`
// begin four operators of three precedences (comparison, shift, compare,
// assignment), and in a type each of them closes a generic. So each
// character is lexed as the token for what it begins, by the characters
// after it on the line (trailing context): `>` before `>=` is GT_SHREQ,
// before `>` GT_SHR, before `=` GT_GE, and otherwise GT. The cuts stay one
// character each, as rustc_lexer has them; the parser sees `>>=` as
// GT_SHREQ GT_GE EQ, knows at the first token that it is an assignment,
// and in a type takes each of the three as a closer. The same holds for
// `= ! < & | + - * / % ^ . :`.
//
// WEAK KEYWORDS. `union`, `auto`, `default`, `raw` and `safe` are keywords
// only before what makes them so (`union` before a name, `auto` before
// `trait`, `default` before an item keyword, `raw` before `const` or `mut`,
// `safe` before `fn` or `static`), and names everywhere else: `a.union(b)`
// and `Default::default()` are names. Each is a token with that trailing
// context, styled keyword; elsewhere the same text lexes as IDENT. A
// context reads its own line only, so a weak keyword whose next word is on
// the next line is a name (rustc reads past the line). `macro_rules` is a
// name: `macro_rules! name { … }` is the macro invocation that takes a
// name, which is how rustc parses it too. `cfg_attr` and `derive` before
// `(` are tokens of their own, so that an attribute can tell a conditional
// attribute and a derive's macros from any other (`#[cfg_attr(test,
// derive(Debug))]`); anywhere else each is a name (`fn derive(…)`), and so
// is any attribute path but the first name of one.
//
// MACROS. A macro invocation may expand to items (`@expands`): among a
// module's items, to the module's; in a block, even as a statement
// (`m!(…);`, which rustc reads as one), to the block's; in a pattern, to a
// binding. What a type macro expands to declares nothing.
//
// EXPRESSION TIERS. As in rustc, an expression is read under one of three
// restrictions, and each is a tier of its own here:
//
//   expr       anywhere an expression goes;
//   cond       the condition of `if` and `while`, the scrutinee of
//              `match`, the iterator of `for`: no struct literal
//              (`if x {}` is `x` then a block), its optional trailing
//              operands (`..`, `return`, `break`) never begin with `{`,
//              and `let` may appear in it (let chains);
//   stmt_expr  an expression that begins a statement or a match arm's
//              body: one beginning with a block-like expression (`if`,
//              `match`, a loop, a block, `m! { … }`) ends there, as a
//              statement of its own, unless `.` or `?` continues it.
//
// The statement tier mirrors the left spine only: its productions take
// `stmt_expr` on the left and `expr` on the right, because the
// restriction is about how a statement begins.
//
// TYPES. `+` joins bounds in `dyn` and `impl` types only where the
// Reference allows a bounded type: after `&`, `*const`, `as`, `->` in a
// function pointer, a type takes one bound (`&dyn A + B` is an error, as
// in rustc). A `self`, `super` or `crate` path segment that ends a type
// path is not a type, which is what tells `pub(self)` from a tuple field
// of type `(self::A, B)` at `)`.
//
// What it leaves out, besides what rust_lex.qana does: a `#!` shebang
// line; `impl <T as A>::B {}` with no generic list (see `impl_def`); a
// path that goes on after `Fn(A) -> B` sugar (see `type_fn_path`);
// unstable syntax (`box`, `yield`, `try` blocks, `do yeet`, `gen` blocks,
// coroutine closures, `impl const`, `~const`, default field values,
// `macro` 2.0, trait aliases, type ascription, `builtin #`); and the 2015
// and 2018 editions' anonymous trait method parameters and bare trait
// objects. examples/rust/README.md has what it was measured on.

language Rust
extensions "rs"
max_stack 8

token WS           = /\s+/      @trivia

// Comments. A doc comment is `///` (not `////`) or `//!`, and `/**` (not
// `/***` or `/**/`) or `/*!`, as rustc_lexer tells them; it is cut where
// any comment is, and a block one reads its body in a mode of its own, so
// all of it is a doc comment. A block comment's `/*` before nothing else
// on its line opens a plain one: it is declared first, so that the
// opener of `/**` before nothing else (a doc comment) is the only one
// whose context then holds.
token DOC_LINE       = /\/\/\/([^\/].*)?|\/\/!.*/       @trivia @style(doc_comment)
token LINE_COMMENT   = /\/\/.*/                         @trivia @style(comment)
token BLOCK_OPEN_EOL = /\/\*(?!.)/                      @trivia @push(BLOCK) @style(comment)
token DOC_OPEN       = /\/\*(?=\*[^*\/]|!)|\/\*(?![^*]|\*.)/ @trivia @push(DOC) @style(doc_comment)
token BLOCK_OPEN     = "/*"                             @trivia @push(BLOCK) @style(comment)

// Strings. A prefix (`b`, `c`, `r`, `br`, `cr`) followed by its quote is
// longer than the identifier it starts with, so longest match takes it.
// Raw strings close on a quote and the same number of `#`: one mode per
// count, up to three.
token RAW3_OPEN = /(b|c)?r###"/ @push(RAW3) @style(string)
token RAW2_OPEN = /(b|c)?r##"/  @push(RAW2) @style(string)
token RAW1_OPEN = /(b|c)?r#"/   @push(RAW1) @style(string)
token RAW0_OPEN = /(b|c)?r"/    @push(RAW0) @style(string)
token STR_OPEN  = /(b|c)?"/     @push(STR)  @style(string)

// `b'…'`: one symbol, or anything up to the closing quote (escapes are
// pairs); rustc_lexer stops an unclosed one at a `/` or the line's end.
token BYTE = /b'[^\\]'([\a_][\w_]*)?|b'([^'\\\/]|\\.)*('([\a_][\w_]*)?)?/ @style(string)

// `'`: a char literal or a lifetime. One symbol between quotes is a
// char. Otherwise, a quote followed by an identifier start or a digit is
// a lifetime, unless a quote closes the identifier (`'ab'`, an error
// rustc reports later). Anything else after the quote is a char literal,
// closed or not. Longest match picks between them.
token CHAR = /'[^\\]'([\a_][\w_]*)?|'\\.([^'\\\/]|\\.)*('([\a_][\w_]*)?)?|'[\a_\d][\w_]*'|'[^\a_\d'\\\/]([^'\\\/]|\\.)*('([\a_][\w_]*)?)?/ @style(string)
token RAW_LIFETIME = /'r#[\a_][\w_]*/ @style(lifetime)
token LIFETIME     = /'[\a_\d][\w_]*/ @style(lifetime)

// Numbers. `1.` is a float unless a `.`, a `_` or a letter follows
// (`1..2`, `1.foo()`): the trailing context. A literal takes an
// identifier as its suffix (`1u8`, `1.5f32`).
token FLOAT = /\d[\d_]*\.\d[\d_]*([eE][+\-]?[\d_]*)?([\a_][\w_]*)?|\d[\d_]*[eE][+\-]?[\d_]*([\a_][\w_]*)?/ @style(number)
// `1.` alone: a float, or (after `x.`) a tuple index and a `.`, which the
// parser splits, as rustc's does (`x.0. await`).
token FLOAT_DOT = /\d[\d_]*\.(?![._\a])/ @style(number)
token INT   = /0b[\d_]*([\a_][\w_]*)?|0o[\d_]*([\a_][\w_]*)?|0x[\da-fA-F_]*([\a_][\w_]*)?|\d[\d_]*([\a_][\w_]*)?/ @style(number)

// Weak keywords, before what makes them keywords (see the header). They
// match as long as a name does, and are declared first, so they win where
// their context holds and IDENT wins everywhere else.
token KW_UNION   = /union(?=\s+[\a_])/                                 @style(keyword)
token KW_AUTO    = /auto(?=\s+trait\s)/                                @style(keyword)
token KW_DEFAULT = /default(?=\s+(fn|type|const|unsafe|async|impl|extern)\s)/ @style(keyword)
token KW_RAW     = /raw(?=\s+(const|mut)\s)/                           @style(keyword)
token KW_SAFE    = /safe(?=\s+(fn|static)\s)/                          @style(keyword)
token KW_CFG_ATTR = /cfg_attr(?=\s*\()/                               @style(variable)
token KW_DERIVE   = /derive(?=\s*\()/                                 @style(variable)

// A raw identifier is never a keyword: `r#fn` is a name.
token RAW_IDENT = /r#[\a_][\w_]*/ @style(variable)
token IDENT     = /[\a_][\w_]*/   @specialize @style(variable)

token LPAREN = "(" @style(bracket)
token RPAREN = ")" @style(bracket)
token LBRACK = "[" @style(bracket)
token RBRACK = "]" @style(bracket)
token LBRACE = "{" @style(bracket)
token RBRACE = "}" @style(bracket)

// Punctuation, one character per token, each lexed as what it begins
// (see the header). Within a character's group, the tokens with a context
// come first: at one length the first declared whose context holds wins.
token EQ_EQ       = /\=(?=\=)/    @style(operator)
token EQ_ARROW    = /\=(?=\>)/    @style(operator)
token EQ          = "="           @style(operator)
token BANG_EQ     = /\!(?=\=)/    @style(operator)
token BANG        = "!"           @style(operator)
token LT_SHLEQ    = /\<(?=\<\=)/  @style(operator)
token LT_SHL      = /\<(?=\<)/    @style(operator)
token LT_LE       = /\<(?=\=)/    @style(operator)
token LT          = "<"           @style(operator)
token GT_SHREQ    = /\>(?=\>\=)/  @style(operator)
token GT_SHR      = /\>(?=\>)/    @style(operator)
token GT_GE       = /\>(?=\=)/    @style(operator)
token GT          = ">"           @style(operator)
token AMP_AMP     = /\&(?=\&)/    @style(operator)
token AMP_EQ      = /\&(?=\=)/    @style(operator)
token AMP         = "&"           @style(operator)
token PIPE_PIPE   = /\|(?=\|)/    @style(operator)
token PIPE_EQ     = /\|(?=\=)/    @style(operator)
token PIPE        = "|"           @style(operator)
token PLUS_EQ     = /\+(?=\=)/    @style(operator)
token PLUS        = "+"           @style(operator)
token MINUS_EQ    = /\-(?=\=)/    @style(operator)
token MINUS_ARROW = /\-(?=\>)/    @style(operator)
token MINUS       = "-"           @style(operator)
token STAR_EQ     = /\*(?=\=)/    @style(operator)
token STAR        = "*"           @style(operator)
token SLASH_EQ    = /\/(?=\=)/    @style(operator)
token SLASH       = "/"           @style(operator)
token PERCENT_EQ  = /\%(?=\=)/    @style(operator)
token PERCENT     = "%"           @style(operator)
token CARET_EQ    = /\^(?=\=)/    @style(operator)
token CARET       = "^"           @style(operator)
token DOT_DOT     = /\.(?=\.)/    @style(punctuation)
token DOT_EQ      = /\.(?=\=)/    @style(punctuation)
token DOT         = "."           @style(punctuation)
token COLON_COLON = /\:(?=\:)/    @style(punctuation)
token COLON       = ":"           @style(punctuation)
token SEMI        = ";"           @style(punctuation)
token COMMA       = ","           @style(punctuation)
token AT          = "@"           @style(punctuation)
token HASH_BANG   = /\#(?=\s*\!)/ @style(punctuation)
token HASH        = "#"           @style(punctuation)
token TILDE       = "~"           @style(punctuation)
token QMARK       = "?"           @style(punctuation)
token DOLLAR      = "$"           @style(punctuation)

// Strict keywords, then the 2018 edition's (`async`, `await`, `dyn`),
// then the reserved ones no edition lets a name take (`try` from 2018).
keywords IDENT =
  as break const continue crate else enum extern false fn for if impl in
  let loop match mod move mut pub ref return self Self static struct super
  trait true type unsafe use where while
  async await dyn
  abstract become box do final macro override priv try typeof unsized
  virtual yield
  "_"

pair "(" ")"
pair "[" "]"
pair "{" "}"

mode BLOCK {
  token B_OPEN    = "/*"      @trivia @push(BLOCK) @style(comment)
  token B_CLOSE   = "*/"      @trivia @pop         @style(comment)
  token B_CONTENT = /[^*\/]+/ @trivia              @style(comment)
  token B_MISC    = /[*\/]/   @trivia              @style(comment)
}

mode STR {
  token S_CLOSE     = /"([\a_][\w_]*)?/ @pop @style(string)
  token S_ESC       = /\\./                  @style(string)
  token S_BACKSLASH = /\\/                   @style(string)
  token S_TEXT      = /[^"\\]+/              @style(string)
}

mode RAW0 {
  token R0_CLOSE = /"([\a_][\w_]*)?/ @pop @style(string)
  token R0_TEXT  = /[^"]+/                @style(string)
}

mode RAW1 {
  token R1_CLOSE = /"#([\a_][\w_]*)?/ @pop @style(string)
  token R1_QUOTE = /"/                     @style(string)
  token R1_TEXT  = /[^"]+/                 @style(string)
}

mode RAW2 {
  token R2_CLOSE = /"##([\a_][\w_]*)?/ @pop @style(string)
  token R2_QUOTE = /"/                      @style(string)
  token R2_TEXT  = /[^"]+/                  @style(string)
}

mode RAW3 {
  token R3_CLOSE = /"###([\a_][\w_]*)?/ @pop @style(string)
  token R3_QUOTE = /"/                       @style(string)
  token R3_TEXT  = /[^"]+/                   @style(string)
}

// A block doc comment's body, cut as a block comment's is: what is nested
// in it is documentation too.
mode DOC {
  token D_OPEN    = "/*"      @trivia @push(DOC) @style(doc_comment)
  token D_CLOSE   = "*/"      @trivia @pop       @style(doc_comment)
  token D_CONTENT = /[^*\/]+/ @trivia            @style(doc_comment)
  token D_MISC    = /[*\/]/   @trivia            @style(doc_comment)
}

// Precedence, loosest first: the Reference's table, with the levels the
// tiers need around it. RETURN is the level of what extends as far right
// as it can (`return`, `break`, closures, an open range in `expr`); a
// brace at the LBRACE level is taken by those and refused by the `cond`
// tier's (which name `..`'s level); `else` binds an `if` before `let …
// else` can.
prec right "return"
prec nonassoc LBRACE
prec right "else"
prec right EQ PLUS_EQ MINUS_EQ STAR_EQ SLASH_EQ PERCENT_EQ CARET_EQ AMP_EQ PIPE_EQ LT_SHLEQ GT_SHREQ
prec nonassoc DOT_DOT
prec left PIPE_PIPE
prec left AMP_AMP
prec nonassoc EQ_EQ BANG_EQ LT GT LT_LE GT_GE
prec left PIPE
prec left CARET
prec left AMP
prec left LT_SHL GT_SHR
prec left PLUS MINUS
prec left STAR SLASH PERCENT
prec left "as"
prec right BANG
prec left QMARK DOT
prec left LPAREN LBRACK

start file

// ---- the file ----

// A file's inner attributes are said of its module, and an item's outer
// ones of what it declares (a module, an import).
rule file = File: a:inner_attrs_opt items_opt @scope(unordered) @attributes(a)

rule items_opt = item*

rule item =
  | Item:      a:outer_attrs_opt k:item_kind @attributes(a, k)
  | PubItem:   a:outer_attrs_opt v:vis k:vis_item_kind @visibility(v, k) @attributes(a, k)
  | ImplItem:  outer_attrs_opt impl_def

// An item in a block. A macro invocation there is a statement (`m! { … }`,
// `m!(…);`), as rustc reads it; a macro definition is an item.
rule stmt_item =
  | StmtItem:        outer_attrs_opt vis_item_kind
  | StmtPubItem:     outer_attrs_opt v:vis k:vis_item_kind @visibility(v, k)
  | StmtImplItem:    outer_attrs_opt impl_def
  | StmtMacroDef:    outer_attrs_opt macro_def

// ---- attributes ----

rule outer_attrs_opt = outer_attr*

rule outer_attr = OuterAttr: h:HASH o:"[" a:attr c:"]" @style(decorator, h, o, a, c)

rule inner_attrs_opt = inner_attr*

rule inner_attr = InnerAttr: h:HASH_BANG b:BANG o:"[" a:attr c:"]" @style(decorator, h, b, o, a, c)

// What an attribute names (a built-in attribute, a derive, a procedural
// macro) is defined in no Rust file this grammar reads: its path stands in
// the `attribute` namespace, where nothing is defined, and escapes. A
// conditional attribute (`cfg_attr(pred, attrs)`) holds its attributes
// under its predicate, which is not decided here. A derive's paths name
// derive macros, in the `derive` namespace, where nothing is defined
// either.
rule attr =
  | Attr:       p:attr_path attr_input_opt @style(inherit, p) @ns(attribute, p) @attribute(p)
  | UnsafeAttr: "unsafe" "(" p:attr_path attr_input_opt ")" @style(inherit, p) @ns(attribute, p) @attribute(p)
  | CfgAttr:    k:KW_CFG_ATTR "(" cfg_meta "," a:cfg_attrs_opt ")" @style(inherit, k, a) @attribute(k) @attributes(a)
  | Derive:     k:KW_DERIVE "(" d:derives_opt ")" @style(inherit, k) @attribute(k) @ns(derive, d)

rule derives_opt =
  | DerivesNone:
  | Derives:      derive_list
  | DerivesTrail: derive_list ","

rule derive_list = derive_item+ % ","

// A derive macro's path, or a macro_rules derive's (`Nothing!`, which a
// `derive` attribute macro of a library's, shadowing the built-in, takes).
rule derive_item =
  | DerivePath: p:attr_path @derives(p)
  | DeriveBang: p:attr_path BANG @derives(p)

rule cfg_attrs_opt =
  | CfgAttrsNone:
  | CfgAttrs:      l:cfg_attr_list @style(inherit, l)
  | CfgAttrsTrail: l:cfg_attr_list "," @style(inherit, l)

rule cfg_attr_list = attr+ % ","

// A configuration predicate: an option (`test`), an option and its value
// (`feature = "std"`), or a name and what it holds (`not(…)`, `all(…)`,
// `version("1.80")`), as a meta item; or a literal (`true`).
rule cfg_meta =
  | CfgPred: cfg_pred
  | CfgLit:  literal

rule cfg_pred =
  | CfgOption: name
  | CfgValue:  name EQ literal
  | CfgList:   name "(" cfg_metas_opt ")"

rule cfg_metas_opt =
  | CfgMetasNone:
  | CfgMetas:      cfg_meta_list
  | CfgMetasTrail: cfg_meta_list ","

rule cfg_meta_list = cfg_meta+ % ","

// An attribute's path: a plain path whose first name is not the
// `cfg_attr` that begins a conditional attribute.
rule attr_path =
  | AttrPathName: p:attr_name_path @style(inherit, p)
  | AttrPathKw:   kw_path

rule attr_name_path =
  | AttrNamePath:      t:attr_name @style(inherit, t) @ref(t, escaping)
  | AttrNamePathMulti: m:attr_path_multi @style(inherit, m)

rule attr_path_multi =
  | AttrPathGlobal:   path_sep t:tlast @style(inherit, t) @root(global, t)
  | AttrPathMoreName: h:attr_name path_sep t:tlast @style(inherit, t) @ref(h, escaping) @qualify(h, t)
  | AttrPathMore:     m:attr_path_multi path_sep t:tlast @style(inherit, t) @qualify(m, t)
  | AttrPathAfterKw:  k:kw_path path_sep t:tlast @style(inherit, t) @qualify(k, t)

rule attr_name =
  | AttrName:    t:IDENT @style(inherit, t)
  | AttrRawName: t:RAW_IDENT @style(inherit, t)

rule attr_input_opt = attr_input?

rule attr_input =
  | AttrTokens: delim_tt
  | AttrValue:  EQ expr

// ---- token trees (macro input) ----

rule delim_tt =
  | ParenTt:   "(" tts ")" @fold(list)
  | BracketTt: "[" tts "]" @fold(list)
  | BraceTt:   "{" tts "}" @fold(block)

rule tts = tt*

rule tt =
  | Tree:  delim_tt
  | Token: tt_token

// Every token but the brackets: a token tree holds any of them.
rule tt_token =
  | TtIdent: IDENT | TtRawIdent: RAW_IDENT | TtLifetime: LIFETIME
  | TtRawLifetime: RAW_LIFETIME | TtInt: INT | TtFloat: FLOAT | TtFloatDot: FLOAT_DOT
  | TtChar: CHAR
  | TtByte: BYTE
  | TtStrOpen: STR_OPEN | TtSClose: S_CLOSE | TtSEsc: S_ESC
  | TtSBackslash: S_BACKSLASH | TtSText: S_TEXT
  | TtRaw0Open: RAW0_OPEN | TtR0Close: R0_CLOSE | TtR0Text: R0_TEXT
  | TtRaw1Open: RAW1_OPEN | TtR1Close: R1_CLOSE | TtR1Quote: R1_QUOTE
  | TtR1Text: R1_TEXT
  | TtRaw2Open: RAW2_OPEN | TtR2Close: R2_CLOSE | TtR2Quote: R2_QUOTE
  | TtR2Text: R2_TEXT
  | TtRaw3Open: RAW3_OPEN | TtR3Close: R3_CLOSE | TtR3Quote: R3_QUOTE
  | TtR3Text: R3_TEXT
  | TtUnion: KW_UNION | TtAuto: KW_AUTO | TtDefault: KW_DEFAULT | TtRaw: KW_RAW
  | TtSafe: KW_SAFE | TtCfgAttr: KW_CFG_ATTR | TtDerive: KW_DERIVE
  | TtEqEq: EQ_EQ | TtEqArrow: EQ_ARROW | TtEq: EQ | TtBangEq: BANG_EQ
  | TtBang: BANG | TtLtShlEq: LT_SHLEQ | TtLtShl: LT_SHL | TtLtLe: LT_LE
  | TtLt: LT | TtGtShrEq: GT_SHREQ | TtGtShr: GT_SHR | TtGtGe: GT_GE | TtGt: GT
  | TtAmpAmp: AMP_AMP | TtAmpEq: AMP_EQ | TtAmp: AMP | TtPipePipe: PIPE_PIPE
  | TtPipeEq: PIPE_EQ | TtPipe: PIPE | TtPlusEq: PLUS_EQ | TtPlus: PLUS
  | TtMinusEq: MINUS_EQ | TtMinusArrow: MINUS_ARROW | TtMinus: MINUS
  | TtStarEq: STAR_EQ | TtStar: STAR | TtSlashEq: SLASH_EQ | TtSlash: SLASH
  | TtPercentEq: PERCENT_EQ | TtPercent: PERCENT | TtCaretEq: CARET_EQ
  | TtCaret: CARET | TtDotDot: DOT_DOT | TtDotEq: DOT_EQ | TtDot: DOT
  | TtColonColon: COLON_COLON | TtColon: COLON | TtSemi: SEMI | TtComma: COMMA
  | TtAt: AT | TtHashBang: HASH_BANG | TtHash: HASH | TtTilde: TILDE | TtQmark: QMARK | TtDollar: DOLLAR
  | TtUnderscore: "_"
  | TtAs: "as" | TtBreak: "break" | TtConst: "const" | TtContinue: "continue"
  | TtCrate: "crate" | TtElse: "else" | TtEnum: "enum" | TtExtern: "extern"
  | TtFalse: "false" | TtFn: "fn" | TtFor: "for" | TtIf: "if" | TtImpl: "impl"
  | TtIn: "in" | TtLet: "let" | TtLoop: "loop" | TtMatch: "match" | TtMod: "mod"
  | TtMove: "move" | TtMut: "mut" | TtPub: "pub" | TtRef: "ref"
  | TtReturn: "return" | TtSelfValue: "self" | TtSelfType: "Self"
  | TtStatic: "static" | TtStruct: "struct" | TtSuper: "super"
  | TtTrait: "trait" | TtTrue: "true" | TtType: "type" | TtUnsafe: "unsafe"
  | TtUse: "use" | TtWhere: "where" | TtWhile: "while" | TtAsync: "async"
  | TtAwait: "await" | TtDyn: "dyn" | TtAbstract: "abstract"
  | TtBecome: "become" | TtBox: "box" | TtDo: "do" | TtFinal: "final"
  | TtMacro: "macro" | TtOverride: "override" | TtPriv: "priv" | TtTry: "try"
  | TtTypeof: "typeof" | TtUnsized: "unsized" | TtVirtual: "virtual"
  | TtYield: "yield"

// ---- names and paths ----

rule name =
  | Name:    t:IDENT @style(inherit, t)
  | RawName: t:RAW_IDENT @style(inherit, t)
  | CfgAttrName: t:KW_CFG_ATTR @style(inherit, t)
  | DeriveName: t:KW_DERIVE @style(inherit, t)

rule lifetime =
  | Lifetime:    t:LIFETIME @style(inherit, t)
  | RawLifetime: t:RAW_LIFETIME @style(inherit, t)

// A lifetime that names one declared elsewhere (`&'a T`, `T: 'a`), as
// against one that declares it (`<'a>`) or a label. `'static` and `'_`
// are declared nowhere: a lifetime reference escapes.
rule lifetime_ref = LifetimeRef: l:lifetime @style(inherit, l) @ref(l, escaping) @ns(lifetime)

// `::`, `->` and `=>` are two tokens each (see the header).
rule path_sep = PathSep: COLON_COLON COLON

// PATHS. A path's prefix is one plain path whatever the path turns out to
// be: what comes after a `::` (a name, `super`, or `<` beginning generic
// arguments) says how it goes on, and the parser reads that token before
// it has to decide anything. What the path has seen so far is in its
// nonterminal: whether it ends in a name (or `Self`) or in `self`,
// `super` or `crate`, and whether generic arguments came before.
//
// A path segment that ends a type or a pattern path, or takes generic
// arguments.
rule tlast =
  | LastName:     n:name @precedence("return") @style(inherit, n)
  | LastSelfType: s:"Self" @precedence("return") @style(inherit, s)

// A segment that begins a path and ends no type: `self`, `super`, `crate`.
rule kseg =
  | KSelf:        s:"self" @style(inherit, s) @root(self)
  | KSuper:       "super" @root(super)
  | KCrate:       "crate" @root(crate)
  | KDollarCrate: DOLLAR "crate" @root(crate)

// A plain path (no generic arguments) ending in a name or `Self`.
rule name_path =
  | NamePath:      t:tlast @style(inherit, t) @ref(t, escaping)
  | NamePathMulti: m:name_path_multi @precedence("return") @style(inherit, m)

// A one-segment head is written out (`name ::`), not a path first: the
// token after `::` (a name, `<`, `(`) is read before anything is decided,
// which is what lets `Item::<T> = U` be a binding in generic arguments.
rule name_path_multi =
  | PathGlobal:    path_sep t:tlast @style(inherit, t) @root(global, t)
  | PathMoreName:  h:name path_sep t:tlast @style(inherit, t) @ref(h, escaping) @qualify(h, t)
  | PathMoreSelf:  s:"Self" path_sep t:tlast @style(inherit, t) @qualify(s, t)
  | PathMore:      m:name_path_multi path_sep t:tlast @style(inherit, t) @qualify(m, t)
  | PathAfterKw:   k:kw_path path_sep t:tlast @style(inherit, t) @qualify(k, t)

// A plain path ending in `self`, `super` or `crate`.
rule kw_path =
  | KwPath:      k:kseg @style(inherit, k)
  | KwPathSuper: kw_path path_sep "super" @root(super)

// A plain path: `use`, visibility, attributes, and macro names.
rule plain_path =
  | PlainName: p:name_path @style(inherit, p)
  | PlainKw:   kw_path

// `<T>` or `<T as Trait>`, before `::`.
rule qself =
  | QSelf:   lt type gt
  | QSelfAs: lt type "as" tr:type_path gt @style(type, tr)

// A qualified path ending in a name.
rule qual_path =
  | QualPath:     qself path_sep t:tlast @style(inherit, t)
  | QualPathMore: qual_path path_sep t:tlast @style(inherit, t)

// An expression path: generic arguments only after `::` (the turbofish).
rule expr_path =
  | ExprName:      p:name_path @style(inherit, p)
  | ExprKw:        k:kw_path @ref(k, escaping)
  | ExprArgs:      p:expr_args_path @style(inherit, p)
  | ExprAfterArgs: p:expr_after_args_path @style(inherit, p)
  | ExprQual:      p:qual_path @style(inherit, p)

// Ending in `::<…>`.
rule expr_args_path =
  | Turbofish:      n:name path_sep generic_args @style(inherit, n) @ref(n, escaping)
  | TurbofishSelf:  "Self" path_sep generic_args
  | TurbofishMulti: m:name_path_multi path_sep generic_args @style(inherit, m)
  | TurbofishAgain: p:expr_after_args_path path_sep generic_args @style(inherit, p)
  | TurbofishQual:  q:qual_path path_sep generic_args @style(inherit, q)

// Generic arguments earlier, ending in a name.
rule expr_after_args_path =
  | AfterTurbofish:     a:expr_args_path path_sep t:tlast @style(inherit, t) @qualify(a, t)
  | AfterTurbofishMore: p:expr_after_args_path path_sep t:tlast @style(inherit, t) @qualify(p, t)

// A type path: generic arguments after a segment, with or without `::`,
// and `Fn(A) -> B` arguments. It never ends in `self`, `super` or
// `crate`, which is what tells `pub(self)` from a tuple field of type
// `(self::A, B)` at `)`. A one-segment path takes its arguments without
// first being a path, so that `Item<'a> = T` in generic arguments (a
// binding) and `Item<'a>` (a type) part only at what follows the `>`.
// Qualified paths (`<T as A>::B`) are a kind of their own, for the one
// place that cannot begin with `<` (see `impl_def`).
rule type_path =
  | TypeUnq:  p:unq_type_path @style(inherit, p)
  | TypeQual: p:qual_type_path @style(inherit, p)

rule unq_type_path =
  | TypePlain:     p:name_path @precedence("return") @style(inherit, p)
  | TypeArgs:      p:type_args_path @precedence("return") @style(inherit, p)
  | TypeAfterArgs: p:type_after_args_path @precedence("return") @style(inherit, p)
  | TypeFnArgs:    p:type_fn_path @style(inherit, p)

rule type_args_path =
  | TArgsName:      n:name generic_args @style(inherit, n) @ref(n, escaping)
  | TArgsSelfType:  "Self" generic_args
  | TArgsMulti:     m:name_path_multi generic_args @style(inherit, m)
  | TArgsTurbofish: n:name path_sep generic_args @style(inherit, n) @ref(n, escaping)
  | TArgsTurbofishSelf:  "Self" path_sep generic_args
  | TArgsTurbofishMulti: m:name_path_multi path_sep generic_args @style(inherit, m)
  | TArgsAgain:     p:type_after_args_path generic_args @style(inherit, p)
  | TArgsAgainTurbofish: p:type_after_args_path path_sep generic_args @style(inherit, p)

// `Fn(A) -> B` ends its path: `-> B::C` is `B::C`.
rule type_fn_path =
  | FnSugarName:    n:name fn_args @style(inherit, n) @ref(n, escaping)
  | FnSugarNameSep: n:name path_sep fn_args @style(inherit, n) @ref(n, escaping)
  | FnSugarMulti:   m:name_path_multi fn_args @style(inherit, m)
  | FnSugarMultiSep: m:name_path_multi path_sep fn_args @style(inherit, m)
  | FnSugarAfterArgs: p:type_after_args_path fn_args @style(inherit, p)

rule type_after_args_path =
  | TAfterArgs:     a:type_args_path path_sep t:tlast @style(inherit, t) @qualify(a, t)
  | TAfterArgsMore: p:type_after_args_path path_sep t:tlast @style(inherit, t) @qualify(p, t)

rule qual_type_path =
  | TQualPath:      q:qual_path @precedence("return") @style(inherit, q)
  | TQualArgs:      q:qual_args_path @precedence("return") @style(inherit, q)
  | TQualAfterArgs: q:qual_after_args_path @precedence("return") @style(inherit, q)
  | TQualFnArgs:    q:qual_fn_path @style(inherit, q)

rule qual_args_path =
  | QArgs:          q:qual_path generic_args @style(inherit, q)
  | QArgsTurbofish: q:qual_path path_sep generic_args @style(inherit, q)
  | QArgsAgain:     q:qual_after_args_path generic_args @style(inherit, q)
  | QArgsAgainTurbofish: q:qual_after_args_path path_sep generic_args @style(inherit, q)

rule qual_fn_path =
  | QFnSugar:          q:qual_path fn_args @style(inherit, q)
  | QFnSugarAfterArgs: q:qual_after_args_path fn_args @style(inherit, q)

rule qual_after_args_path =
  | QAfterArgs:     qual_args_path path_sep t:tlast @style(inherit, t)
  | QAfterArgsMore: qual_after_args_path path_sep t:tlast @style(inherit, t)

rule fn_args =
  | FnArgs:    "(" types_opt ")"
  | FnArgsRet: "(" types_opt ")" fn_ret_nb

// `<` opens a generic list, and so does `<` before `<` (`Vec<<T as A>::B>`).
rule lt =
  | Lt:    LT
  | LtShl: LT_SHL

// Any `>` closes one: `>>=` after a type closes two and leaves `=`.
rule gt =
  | Gt:      GT
  | GtGe:    GT_GE
  | GtShr:   GT_SHR
  | GtShrEq: GT_SHREQ

rule generic_args =
  | GenericArgsEmpty: lt gt
  | GenericArgs:      lt generic_arg_list gt
  | GenericArgsTrail: lt generic_arg_list "," gt

rule generic_arg_list = generic_arg+ % ","

rule generic_arg =
  | TypeArg:        t:type @type_ref(arg, t)
  | LifetimeArg:    lifetime_ref
  | ConstBlockArg:  block @type_ref(const)
  | ConstLitArg:    literal @type_ref(const)
  | ConstNegArg:    MINUS literal @type_ref(const)
  | BindingArg:     n:name EQ t:type @style(type, n) @type_ref(binding, n, t)
  | BindingArgsArg: n:name generic_args EQ t:type @style(type, n) @type_ref(binding, n, t)
  | BindingTurbofishArg: n:name path_sep generic_args EQ t:type @style(type, n) @type_ref(binding, n, t)
  | BoundArg:       n:name COLON bounds @style(type, n)
  | BoundArgsArg:   n:name generic_args COLON bounds @style(type, n)
  | BoundTurbofishArg: n:name path_sep generic_args COLON bounds @style(type, n)

// ---- items ----

// Items. Visibility is not an optional prefix: in a block, deciding it
// absent before an `unsafe` or a `const` would have to tell an
// `unsafe fn` from an `unsafe {}` block a token too soon. So an item is
// either one of these, or a visibility then one of those that take it.
rule item_kind =
  | Plain:        vis_item_kind
  | ItemMacro:    item_macro
  | ItemMacroDef: macro_def

rule vis_item_kind =
  | Use:          "use" use_tree ";"
  | ModDecl:      mod_head n:name ";" @outline(n, module) @def(n, hoisted, open) @unit(n)
  | ModDef:       mod_head n:name open:"{" a:inner_attrs_opt b:items_opt "}" @outline(n, module) @fold(block, open) @def(n, hoisted, open) @unit(n, b) @scope(unordered, barrier) @attributes(a, n)
  | Fn:           fn_def
  | Struct:       struct_def
  | Enum:         "enum" n:name generics_opt where_opt open:"{" v:variants_opt "}" @outline(n, struct) @fold(block, open) @style(type, n) @def(n, hoisted, open) @module(v) @scope
  | Union:        KW_UNION n:name generics_opt where_opt open:"{" fields_opt "}" @outline(n, struct) @fold(block, open) @style(type, n) @def(n, hoisted, open) @scope
  | Const:        const_def
  | Static:       static_def
  | TypeAlias:    type_alias
  | Trait:        trait_head n:name generics_opt s:colon_bounds_opt where_opt open:"{" b:assoc_body "}" @outline(n, class) @fold(block, open) @style(type, n) @def(n, hoisted, open) @module(b) @scope @bounds(s)
  | ExternBlock:  extern_head open:"{" inner_attrs_opt foreign_items_opt "}" @fold(block, open)
  | ExternCrate:  "extern" "crate" n:name ";" @outline(n, module) @def(n, hoisted, open) @root(global, n) @import @loads
  | ExternCrateAs: "extern" "crate" n:name "as" r:name ";" @outline(n, module) @def(r, hoisted, open) @root(global, n) @import @loads
  | ExternSelfAs: "extern" "crate" "self" "as" r:name ";" @def(r, hoisted, open) @root(crate) @import @loads
  | ExternSelf:   "extern" "crate" "self" ";"
  | ExternCrateAsUnderscore: "extern" "crate" n:name "as" "_" ";" @outline(n, module)
  | ExternSelfAsUnderscore: "extern" "crate" "self" "as" "_" ";"

rule mod_head =
  | Mod:       "mod"
  | UnsafeMod: "unsafe" "mod"

rule vis_opt = vis?

rule vis =
  | Pub:      "pub" @vis(public)
  | PubCrate: "pub" "(" "crate" ")" @vis(crate)
  | PubSelf:  "pub" "(" "self" ")" @vis(private)
  | PubSuper: "pub" "(" "super" ")" @vis(super)
  | PubIn:    "pub" "(" "in" p:plain_path ")" @ns(import, p) @vis(in, p)

// `use` trees. A leaf defines its name where the `use` stands, open: what
// it imports has members the file cannot see. Its path names what is
// imported (`@import`), from the prefixes of the groups it is in
// (`@import_prefix`); a project index resolves it, through units, across
// files. Within the file the path's references stand in the `import`
// namespace, where nothing is defined, and escape.
rule use_tree =
  | UsePath:       p:plain_path @def(p, hoisted, open) @ns(import, p) @import(p)
  | UseRename:     p:plain_path "as" n:name @def(n, hoisted, open) @ns(import, p) @import(p)
  | UseRenameUnderscore: p:plain_path "as" "_" @ns(import, p) @import(p)
  | UseGlob:       n:name path_sep STAR @import_glob(n)
  | UseMultiGlob:  m:name_path_multi path_sep STAR @ns(import, m) @import_glob(m)
  | UseKwGlob:     k:kw_path path_sep STAR @import_glob(k)
  | UseGroup:      n:name path_sep open:"{" t:use_trees_opt "}" @fold(list, open) @import_prefix(n, t)
  | UseMultiGroup: m:name_path_multi path_sep open:"{" t:use_trees_opt "}" @fold(list, open) @ns(import, m) @import_prefix(m, t)
  | UseKwGroup:    k:kw_path path_sep open:"{" t:use_trees_opt "}" @fold(list, open) @import_prefix(k, t)
  | UseRootGlob:   STAR @import_glob
  | UseGlobalGlob: path_sep STAR @root(global) @import_glob
  | UseRootGroup:  "{" use_trees_opt "}" @fold(list)
  | UseGlobalGroup: path_sep open:"{" t:use_trees_opt "}" @fold(list, open) @root(global) @import_prefix(t)

rule use_trees_opt =
  | UseTreesNone:
  | UseTrees:      use_tree_list
  | UseTreesTrail: use_tree_list ","

rule use_tree_list = use_tree+ % ","

// Functions. The qualifiers are written out, not optional: an optional
// prefix would ask the parser to decide it is absent before it sees what
// the `unsafe` or `const` it is reading begins (an `unsafe impl`, a
// `const` item), which one token cannot tell.
rule fn_def = FnDef: fn_head n:name generics_opt open:"(" params_opt close:")" r:fn_ret_opt where_opt fn_body @outline(n, function) @fold(list, open, close) @style(function, n) @def(n, hoisted) @scope @returns(r)

rule fn_body =
  | FnBlock: block_body
  | FnNoBody: ";"

rule fn_head =
  | FnPlain: "fn"
  | FnQual:  fn_quals "fn"

rule fn_quals =
  | QConst:   "const"
  | QAsync:   "async"
  | QUnsafe:  "unsafe"
  | QSafe:    KW_SAFE
  | QExtern:  "extern" abi_opt
  | QConstAsync:  "const" "async"
  | QConstUnsafe: "const" "unsafe"
  | QConstExtern: "const" "extern" abi_opt
  | QConstAsyncUnsafe: "const" "async" "unsafe"
  | QConstUnsafeExtern: "const" "unsafe" "extern" abi_opt
  | QAsyncUnsafe: "async" "unsafe"
  | QAsyncExtern: "async" "extern" abi_opt
  | QAsyncUnsafeExtern: "async" "unsafe" "extern" abi_opt
  | QUnsafeExtern: "unsafe" "extern" abi_opt
  | QSafeExtern:   KW_SAFE "extern" abi_opt
  | QDefault:      KW_DEFAULT
  | QDefaultConst: KW_DEFAULT "const"
  | QDefaultAsync: KW_DEFAULT "async"
  | QDefaultUnsafe: KW_DEFAULT "unsafe"
  | QDefaultAsyncUnsafe: KW_DEFAULT "async" "unsafe"
  | QDefaultConstUnsafe: KW_DEFAULT "const" "unsafe"
  | QDefaultExtern: KW_DEFAULT "extern" abi_opt
  | QDefaultUnsafeExtern: KW_DEFAULT "unsafe" "extern" abi_opt

rule abi_opt = str_lit?

rule params_opt =
  | ParamsNone:
  | Params:      param_list
  | ParamsTrail: param_list ","

rule param_list = param+ % ","

rule param =
  | SelfParam:     outer_attrs_opt self_param
  | Param:         outer_attrs_opt p:pat_no_alt COLON t:type @typed(p, t)
  | VariadicParam: outer_attrs_opt DOT_DOT DOT_DOT DOT
  | NamedVariadic: outer_attrs_opt pat_no_alt COLON DOT_DOT DOT_DOT DOT

rule self_param =
  | SelfValue:      s:"self" @def(s)
  | SelfMut:        "mut" s:"self" @def(s)
  | SelfRef:        amp s:"self" @def(s)
  | SelfRefMut:     amp "mut" s:"self" @def(s)
  | SelfRefLt:      amp lifetime_ref s:"self" @def(s)
  | SelfRefLtMut:   amp lifetime_ref "mut" s:"self" @def(s)
  | SelfTyped:      s:"self" COLON t:type @def(s) @typed(s, t)
  | SelfMutTyped:   "mut" s:"self" COLON t:type @def(s) @typed(s, t)

rule fn_ret_opt = fn_ret?

rule fn_ret = FnRet: MINUS_ARROW GT type

rule fn_ret_nb = FnRetNb: MINUS_ARROW GT type_nb

// Structs.
rule struct_def =
  | NamedStruct: "struct" n:name generics_opt where_opt open:"{" fields_opt "}" @outline(n, struct) @fold(block, open) @style(type, n) @def(n, hoisted, open) @scope
  | TupleStruct: "struct" n:name generics_opt open:"(" f:tuple_fields_opt close:")" where_opt ";" @outline(n, struct) @fold(list, open, close) @style(type, n) @def(n, hoisted, open) @scope @positional(f)
  | UnitStruct:  "struct" n:name generics_opt where_opt ";" @outline(n, struct) @style(type, n) @def(n, hoisted, open) @scope

// Fields are members: reached through a value (`p.x`) or a literal or
// pattern of the type, never by a plain name.
rule fields_opt =
  | FieldsNone:
  | Fields:      field_list @scope(members)
  | FieldsTrail: field_list "," @scope(members)

rule field_list = field+ % ","

rule field = Field: outer_attrs_opt v:vis_opt n:name COLON t:type @outline(n, field) @def(n, hoisted) @visibility(v, n) @typed(n, t)

// A tuple field: after `pub (`, the next token tells a restricted
// visibility (`crate`, `self`, `super`, `in`) from a tuple type, where
// `pub` then the type would have had to decide at `(` (see `type_nb`).
rule tuple_fields_opt =
  | TupleFieldsNone:
  | TupleFields:      tuple_field_list
  | TupleFieldsTrail: tuple_field_list ","

rule tuple_field_list = tuple_field+ % ","

rule tuple_field =
  | TupleField:        outer_attrs_opt type
  | TupleFieldPub:     outer_attrs_opt "pub" type_np
  | TupleFieldPubParen: outer_attrs_opt "pub" "(" paren_type_rest
  | TupleFieldPubCrate: outer_attrs_opt "pub" "(" "crate" ")" type
  | TupleFieldPubSelf:  outer_attrs_opt "pub" "(" "self" ")" type
  | TupleFieldPubSuper: outer_attrs_opt "pub" "(" "super" ")" type
  | TupleFieldPubIn:    outer_attrs_opt "pub" "(" "in" plain_path ")" type

// Enums.
// Variants are members: `E::A`, or `A` after `use E::*`.
rule variants_opt =
  | VariantsNone:
  | Variants:      variant_list @scope(members)
  | VariantsTrail: variant_list "," @scope(members)

rule variant_list = variant+ % ","

rule variant =
  | Variant:       outer_attrs_opt vis_opt n:name discriminant_opt @outline(n, constant) @def(n, hoisted)
  | TupleVariant:  outer_attrs_opt vis_opt n:name open:"(" f:tuple_fields_opt close:")" discriminant_opt @outline(n, constant) @fold(list, open, close) @def(n, hoisted) @positional(f)
  | StructVariant: outer_attrs_opt vis_opt n:name open:"{" fields_opt close:"}" discriminant_opt @outline(n, constant) @fold(block, open, close) @def(n, hoisted)

rule discriminant_opt = discriminant?

rule discriminant = Discriminant: EQ expr

// Constants and statics.
rule const_def =
  | ConstItem:      "const" n:const_name COLON t:type EQ expr ";" @outline(n, constant) @def(n, hoisted) @typed(n, t)
  | ConstNoValue:   "const" n:const_name COLON t:type ";" @outline(n, constant) @def(n, hoisted) @typed(n, t)
  | DefaultConst:   KW_DEFAULT "const" n:const_name COLON t:type EQ expr ";" @outline(n, constant) @def(n, hoisted) @typed(n, t)

// `const _` names nothing.
rule const_name =
  | ConstName:       n:name @style(inherit, n)
  | ConstUnderscore: "_"

rule static_def =
  | StaticItem:     static_head n:name COLON t:type EQ expr ";" @outline(n, constant) @def(n, hoisted) @typed(n, t)
  | StaticNoValue:  static_head n:name COLON t:type ";" @outline(n, constant) @def(n, hoisted) @typed(n, t)

rule static_head =
  | StaticPlain:     "static"
  | StaticMut:       "static" "mut"
  | StaticSafe:      KW_SAFE "static"
  | StaticSafeMut:   KW_SAFE "static" "mut"
  | StaticUnsafe:    "unsafe" "static"
  | StaticUnsafeMut: "unsafe" "static" "mut"

rule type_alias =
  | TypeAliasDef:     type_head n:name generics_opt s:colon_bounds_opt where_opt EQ t:type where_opt ";" @outline(n, struct) @style(type, n) @def(n, hoisted, open) @scope @typed(n, t) @bounds(s)
  | TypeAliasNoValue: type_head n:name generics_opt s:colon_bounds_opt where_opt ";" @outline(n, struct) @style(type, n) @def(n, hoisted, open) @scope @bounds(s)

rule type_head =
  | TypeKw:        "type"
  | DefaultTypeKw: KW_DEFAULT "type"

// Traits and impls.
rule trait_head =
  | TraitKw:           "trait"
  | UnsafeTrait:       "unsafe" "trait"
  | AutoTrait:         KW_AUTO "trait"
  | UnsafeAutoTrait:   "unsafe" KW_AUTO "trait"

rule colon_bounds_opt = colon_bounds?

rule colon_bounds =
  | ColonBounds:      COLON bounds
  | ColonBoundsEmpty: COLON

// `impl` then `<` begins generics: whether it began a qualified self
// type instead (`impl <T as A>::B {}`) is rustc's to tell by reading on,
// which one token cannot; written `impl<> <T as A>::B {}` it parses.
rule impl_def =
  | InherentImpl:  impl_head impl_rest @scope
  | PubImpl:       vis impl_head impl_rest @scope

rule impl_rest =
  | ImplPlain:     impl_target_plain
  | ImplGenerics:  generics impl_target

rule impl_target_plain =
  | InherentTargetPlain: t:impl_type where_opt open:"{" assoc_body "}" @outline(t, class) @fold(block, open) @impl(t)
  | TraitTargetPlain:    tr:unq_type_path "for" t:type where_opt open:"{" assoc_body "}" @outline(t, class) @fold(block, open) @style(type, tr) @impl(t, tr)
  | NegTargetPlain:      BANG tr:type_path "for" t:type where_opt open:"{" assoc_body "}" @outline(t, class) @fold(block, open) @style(type, tr) @impl(t, tr)

rule impl_target =
  | InherentTarget: t:type where_opt open:"{" assoc_body "}" @outline(t, class) @fold(block, open) @impl(t)
  | TraitTarget:    tr:type_path "for" t:type where_opt open:"{" assoc_body "}" @outline(t, class) @fold(block, open) @style(type, tr) @impl(t, tr)
  | NegTarget:      BANG tr:type_path "for" t:type where_opt open:"{" assoc_body "}" @outline(t, class) @fold(block, open) @style(type, tr) @impl(t, tr)

rule impl_head =
  | ImplKw:        "impl"
  | UnsafeImpl:    "unsafe" "impl"
  | DefaultImpl:   KW_DEFAULT "impl"
  | DefaultUnsafeImpl: KW_DEFAULT "unsafe" "impl"

// An impl's or a trait's items are members: `Type::item`, `Self::item`,
// `value.method()`, never a plain name, even inside the impl.
rule assoc_body = AssocBody: inner_attrs_opt assoc_items_opt @scope(members)

rule assoc_items_opt = assoc_item*

rule assoc_item =
  | AssocItem:    outer_attrs_opt assoc_vis_kind
  | PubAssocItem: outer_attrs_opt v:vis k:assoc_vis_kind @visibility(v, k)
  | AssocMacro:   outer_attrs_opt item_macro
  | AssocMacroDef: outer_attrs_opt macro_def

rule assoc_vis_kind =
  | AssocFn:     fn_def
  | AssocConst:  const_def
  | AssocType:   type_alias

// Extern blocks.
rule extern_head =
  | ExternKw:        "extern" abi_opt
  | UnsafeExternKw:  "unsafe" "extern" abi_opt

rule foreign_items_opt = foreign_item*

rule foreign_item =
  | ForeignItem:    outer_attrs_opt foreign_vis_kind
  | PubForeignItem: outer_attrs_opt v:vis k:foreign_vis_kind @visibility(v, k)
  | ForeignMacro:   outer_attrs_opt item_macro

rule foreign_vis_kind =
  | ForeignFn:      fn_def
  | ForeignStatic:  static_def
  | ForeignType:    type_alias

// Macro invocations as items and statements: with a name after `!`, the
// definition form (`macro_rules! name { … }`); in brackets or parentheses
// a `;` ends it.
rule item_macro =
  | MacroItemBrace:   p:plain_path b:BANG open:"{" tts "}" @fold(block, open) @style(macro, p, b) @ns(macro, p) @expands
  | MacroItemParen:   p:plain_path b:BANG open:"(" tts close:")" ";" @fold(list, open, close) @style(macro, p, b) @ns(macro, p) @expands
  | MacroItemBracket: p:plain_path b:BANG open:"[" tts close:"]" ";" @fold(list, open, close) @style(macro, p, b) @ns(macro, p) @expands

rule macro_def = MacroDef: p:plain_path b:BANG n:name delim_tt_def @outline(n, function) @style(macro, p, b, n) @def(n, hoisted) @ns(macro) @ns(macro, p)

rule delim_tt_def =
  | MacroDefBrace:   "{" tts "}" @fold(block)
  | MacroDefParen:   open:"(" tts close:")" ";" @fold(list, open, close)
  | MacroDefBracket: open:"[" tts close:"]" ";" @fold(list, open, close)

// ---- generics and bounds ----

rule generics_opt = generics?

rule generics =
  | GenericsEmpty: lt gt @fold(list)
  | Generics:      lt generic_param_list gt @fold(list)
  | GenericsTrail: lt generic_param_list "," gt @fold(list)

rule generic_param_list = generic_param+ % ","

rule generic_param =
  | LifetimeParam: outer_attrs_opt l:lifetime lifetime_bounds_opt @def(l, hoisted) @ns(lifetime)
  | TypeParam:     outer_attrs_opt n:name colon_bounds_opt type_default_opt @style(type, n) @def(n, hoisted, open) @generic
  | ConstParam:    outer_attrs_opt "const" n:name COLON type const_default_opt @def(n, hoisted) @generic

rule lifetime_bounds_opt = lifetime_bounds?

rule lifetime_bounds =
  | LifetimeBounds:      COLON lifetime_plus
  | LifetimeBoundsEmpty: COLON

rule lifetime_plus =
  | LifetimePlusOne:   lifetime_ref
  | LifetimePlusMore:  lifetime_plus PLUS lifetime_ref
  | LifetimePlusTrail: lifetime_plus PLUS

rule type_default_opt = type_default?

rule type_default = TypeDefault: EQ type

rule const_default_opt = const_default?

rule const_default = ConstDefault: EQ generic_arg

rule where_opt = where_clause?

rule where_clause =
  | WhereEmpty: "where"
  | Where:      "where" where_pred_list
  | WhereTrail: "where" where_pred_list ","

rule where_pred_list = where_pred+ % ","

rule where_pred =
  | LifetimePred:   lifetime_ref COLON lifetime_plus
  | LifetimePredEmpty: lifetime_ref COLON
  | TypePred:       pred_type COLON bounds
  | TypePredEmpty:  pred_type COLON
  | ForTypePred:    for_lifetimes type COLON bounds @scope
  | ForTypePredEmpty: for_lifetimes type COLON @scope

rule for_lifetimes = ForLifetimes: "for" generics

rule bounds =
  | BoundsOne:   bound
  | BoundsMore:  bounds PLUS bound
  | BoundsTrail: bounds PLUS

rule bound =
  | TraitBound:       trait_bound
  | ParenTraitBound:  "(" trait_bound ")"
  | LifetimeBound:    lifetime_ref
  | UseBound:         "use" generic_args @type_ref(other)

rule trait_bound =
  | Bound:          tr:type_path @style(type, tr) @type_ref(path, tr)
  | MaybeBound:     QMARK tr:type_path @style(type, tr) @type_ref(other)
  | ForBound:       for_lifetimes tr:type_path @style(type, tr) @scope @type_ref(path, tr)
  | MaybeForBound:  QMARK for_lifetimes tr:type_path @style(type, tr) @scope @type_ref(other)
  | AsyncBound:     "async" tr:type_path @style(type, tr) @type_ref(path, tr)

// ---- types ----

// A type with bounds (`dyn A + B`, `impl A + B`) where the Reference
// allows one, and `type_nb` (one bound) where it does not.
rule type =
  | TypeNb:      type_nb
  | ImplBounds:  "impl" bound PLUS bounds @type_ref(impl)
  | DynBounds:   "dyn" bound PLUS bounds @type_ref(dyn)

rule type_nb =
  | TypeNp:      type_np
  | ParenType:   "(" paren_type_rest

// A type not beginning with `(`.
rule type_np =
  | CoreType:     type_np_core
  | QualType:     p:qual_type_path @style(type, p) @type_ref(path, p)
  | ForFnPtrType: for_lifetimes fn_ptr @scope @type_ref(other)

// The types that begin with neither `(`, `<` nor `for`.
rule type_np_core =
  | PathType:    p:unq_type_path @style(type, p) @type_ref(path, p)
  | RefType:     amp t:type_nb @type_ref(ref, t)
  | RefMutType:  amp "mut" t:type_nb @type_ref(ref, t)
  | RefLtType:   amp lifetime_ref t:type_nb @type_ref(ref, t)
  | RefLtMutType: amp lifetime_ref "mut" t:type_nb @type_ref(ref, t)
  | ConstPtr:    STAR "const" t:type_nb @type_ref(ref, t)
  | MutPtr:      STAR "mut" t:type_nb @type_ref(ref, t)
  | SliceType:   "[" t:type "]" @type_ref(slice, t)
  | ArrayType:   "[" t:type ";" expr "]" @type_ref(array, t)
  | NeverType:   BANG @type_ref(other)
  | ImplType:    "impl" bound @type_ref(impl)
  | DynType:     "dyn" bound @type_ref(dyn)
  | FnPtrType:   fn_ptr @type_ref(other)
  | MacroType:   p:plain_path b:BANG delim_tt @style(macro, p, b) @ns(macro, p) @type_ref(other)
  | InferType:   "_" @type_ref(other)

// The type an `impl` without generics is for: not a qualified path, since
// `impl <` begins generics (see `impl_def`).
rule impl_type =
  | ImplCoreType:  type_np_core
  | ImplForFnPtr:  for_lifetimes fn_ptr @scope @type_ref(other)
  | ImplParenType: "(" paren_type_rest
  | ImplDynBounds: "dyn" bound PLUS bounds @type_ref(dyn)

// What a `where` predicate bounds: not a function pointer type with a
// `for<…>` of its own, since `where for<'a> …` binds the predicate.
rule pred_type =
  | PredCoreType:  type_np_core
  | PredQualType:  p:qual_type_path @style(type, p)
  | PredParenType: "(" paren_type_rest

// After `(`: `()`, `(T)`, `(T,)`, `(T, U, …)`.
rule paren_type_rest =
  | UnitType:       ")" @type_ref(tuple)
  | ParenTypeOne:   type ")"
  | TupleTypeOne:   type "," ")" @type_ref(tuple)
  | TupleType:      type "," type_list ")" @type_ref(tuple)
  | TupleTypeTrail: type "," type_list "," ")" @type_ref(tuple)

rule type_list = type+ % ","

rule types_opt =
  | TypesNone:
  | Types:      type_list
  | TypesTrail: type_list ","

rule fn_ptr =
  | FnPtr:         fn_ptr_head "(" fn_ptr_params_opt ")"
  | FnPtrRet:      fn_ptr_head "(" fn_ptr_params_opt ")" fn_ret_nb

rule fn_ptr_head =
  | FnPtrPlain:        "fn"
  | FnPtrUnsafe:       "unsafe" "fn"
  | FnPtrExtern:       "extern" abi_opt "fn"
  | FnPtrUnsafeExtern: "unsafe" "extern" abi_opt "fn"

rule fn_ptr_params_opt =
  | FnPtrParamsNone:
  | FnPtrParams:      fn_ptr_param_list
  | FnPtrParamsTrail: fn_ptr_param_list ","

rule fn_ptr_param_list = fn_ptr_param+ % ","

rule fn_ptr_param =
  | FnPtrParam:      outer_attrs_opt type
  | FnPtrNamedParam: outer_attrs_opt name COLON type
  | FnPtrUnnamedParam: outer_attrs_opt "_" COLON type
  | FnPtrVariadic:   outer_attrs_opt DOT_DOT DOT_DOT DOT

rule amp =
  | Amp:    AMP
  | AmpAmp: AMP_AMP

// ---- patterns ----

// A pattern, with alternatives, and a `|` before the first where the
// Reference allows one (a match arm, `if let`, `for`, and inside tuples,
// slices and fields); `let` and parameters take `pat_no_alt`.
rule pat =
  | Pat:         pat_alts
  | LeadPipePat: PIPE pat_alts

rule pat_alts = pat_no_alt+ % PIPE

rule pat_no_alt =
  | NoRangePat:     pat_nr
  | RestPat:        DOT_DOT DOT
  | RangeInclPat:   range_bound DOT_DOT DOT_EQ EQ range_bound
  | RangeDotsPat:   range_bound DOT_DOT DOT_DOT DOT range_bound
  | RangeExclPat:   range_bound DOT_DOT DOT range_bound
  | RangeFromPat:   range_bound DOT_DOT DOT
  | RangeToPat:     DOT_DOT DOT_EQ EQ range_bound
  | RangeToExclPat: DOT_DOT DOT range_bound

// A pattern without a range: what `&` and `&mut` take (`&0..=9` is an
// error). After `&`, a pattern does not begin with `mut`: `&mut x` is a
// `&mut` pattern, as rustc reads it, and `&mut mut x` binds mutably
// inside one.
// A name in a pattern binds it. (A lone name that resolves to a unit
// struct, a unit variant or a constant is a path instead, as rustc reads
// it; telling which needs the names other files and the preludes
// declare, so here it binds.)
rule pat_nr =
  | NoMutPat:       pat_nr_nomut
  | MutIdentPat:    "mut" n:name @def(n)
  | MutBindPat:     "mut" n:name AT pat_no_alt @def(n)

rule pat_nr_nomut =
  | IdentPat:       n:name @def(n)
  | WildPat:        "_"
  | RefIdentPat:    "ref" n:name @def(n)
  | RefMutIdentPat: "ref" "mut" n:name @def(n)
  | BindPat:        n:name AT pat_no_alt @def(n)
  | RefBindPat:     "ref" n:name AT pat_no_alt @def(n)
  | RefMutBindPat:  "ref" "mut" n:name AT pat_no_alt @def(n)
  | LitPat:         literal
  | NegLitPat:      MINUS literal
  | PathPat:        pat_path
  | TupleStructPat: pat_head open:"(" pats_opt ")" @fold(list, open)
  | StructPat:      pat_head open:"{" pat_fields_opt "}" @fold(list, open)
  | TuplePat:       "(" pats_opt ")" @fold(list)
  | SlicePat:       "[" pats_opt "]" @fold(list)
  | RefPat:         amp pat_nr_nomut
  | RefMutPat:      amp "mut" pat_nr
  | MacroPat:       p:plain_path b:BANG delim_tt @style(macro, p, b) @ns(macro, p) @expands

// A path in a pattern: one name is an identifier pattern, so a path is
// more than one segment, `Self`, qualified, or with generic arguments.
// `self`, `super` and `crate` are no pattern alone.
rule pat_path =
  | PatPathMulti:     name_path_multi
  | PatPathSelfType:  "Self"
  | PatPathArgs:      expr_args_path
  | PatPathAfterArgs: expr_after_args_path
  | PatPathQual:      qual_path

// What a tuple-struct or struct pattern names.
rule pat_head =
  | PatHeadName: n:name @ref(n, escaping)
  | PatHeadPath: pat_path

rule range_bound =
  | BoundLit:     literal
  | BoundNegLit:  MINUS literal
  | BoundName:    n:name @ref(n, escaping)
  | BoundPath:    pat_path

rule pats_opt =
  | PatsNone:
  | Pats:      pat_list
  | PatsTrail: pat_list ","

rule pat_list = pat+ % ","

rule pat_fields_opt =
  | PatFieldsNone:
  | PatFields:      pat_field_list
  | PatFieldsTrail: pat_field_list ","
  | PatFieldsRest:  pat_field_list "," outer_attrs_opt DOT_DOT DOT
  | PatFieldsOnlyRest: outer_attrs_opt DOT_DOT DOT

rule pat_field_list = pat_field+ % ","

rule pat_field =
  | PatFieldShort:       outer_attrs_opt n:name @def(n)
  | PatFieldMutShort:    outer_attrs_opt "mut" n:name @def(n)
  | PatFieldRefShort:    outer_attrs_opt "ref" n:name @def(n)
  | PatFieldRefMutShort: outer_attrs_opt "ref" "mut" n:name @def(n)
  | PatField:            outer_attrs_opt name COLON pat
  | PatFieldIndex:       outer_attrs_opt INT COLON pat

// ---- literals ----

rule literal =
  | IntLit:   INT
  | FloatLit: FLOAT
  | FloatDotLit: FLOAT_DOT
  | CharLit:  CHAR
  | ByteLit:  BYTE
  | StrLit:   str_lit
  | True:     "true"
  | False:    "false"

rule str_lit =
  | Str:  STR_OPEN str_parts S_CLOSE @fold(string)
  | Raw0: RAW0_OPEN raw0_parts R0_CLOSE @fold(string)
  | Raw1: RAW1_OPEN raw1_parts R1_CLOSE @fold(string)
  | Raw2: RAW2_OPEN raw2_parts R2_CLOSE @fold(string)
  | Raw3: RAW3_OPEN raw3_parts R3_CLOSE @fold(string)

rule str_parts = str_part*
rule str_part = | StrText: S_TEXT | StrEsc: S_ESC | StrBackslash: S_BACKSLASH
rule raw0_parts = raw0_part*
rule raw0_part = Raw0Text: R0_TEXT
rule raw1_parts = raw1_part*
rule raw1_part = | Raw1Text: R1_TEXT | Raw1Quote: R1_QUOTE
rule raw2_parts = raw2_part*
rule raw2_part = | Raw2Text: R2_TEXT | Raw2Quote: R2_QUOTE
rule raw3_parts = raw3_part*
rule raw3_part = | Raw3Text: R3_TEXT | Raw3Quote: R3_QUOTE

// ---- blocks and statements ----

rule block = Block: "{" inner_attrs_opt stmts_opt tail_opt "}" @fold(block) @scope

// A function's body: the same as a block.
rule block_body = BlockBody: "{" inner_attrs_opt stmts_opt tail_opt "}" @fold(block) @scope

rule stmts_opt = stmt*

rule tail_opt = tail?

// The expression a block ends with, without `;`.
rule tail = Tail: outer_attrs_opt stmt_expr

rule stmt =
  | EmptyStmt:  ";"
  | ItemStmt:   stmt_item
  | LetStmt:    outer_attrs_opt "let" p:pat_no_alt a:type_ann_opt let_init_opt ";" @defer(p) @typed(p, a)
  | ExprStmt:   outer_attrs_opt stmt_expr ";"
  | BlockStmt:  outer_attrs_opt block_like

rule type_ann_opt = type_ann?

rule type_ann = TypeAnn: COLON type

rule let_init_opt = let_init?

rule let_init =
  | LetInit:     EQ expr
  | LetInitElse: EQ expr "else" block

// ---- block-like expressions ----

rule block_like =
  | BlockExpr:      block
  | UnsafeBlock:    "unsafe" block
  | AsyncBlock:     "async" block
  | AsyncMoveBlock: "async" "move" block
  | ConstBlock:     "const" block
  | LabeledBlock:   label block @scope
  | If:             if_expr
  | Match:          "match" cond open:"{" inner_attrs_opt arms_opt "}" @fold(block, open)
  | Loop:           "loop" block
  | LabeledLoop:    label "loop" block @scope
  | While:          "while" cond block @scope
  | LabeledWhile:   label "while" cond block @scope
  | For:            "for" p:pat "in" c:cond block @defer(p, c) @scope
  | LabeledFor:     label "for" p:pat "in" c:cond block @defer(p, c) @scope
  | BraceMacro:     p:plain_path b:BANG open:"{" tts "}" @fold(block, open) @style(macro, p, b) @ns(macro, p) @expands

rule label = Label: l:lifetime COLON @style(label, l) @def(l) @ns(label)

// What a condition's `let` binds is seen by the block after it, and not
// by an `else`: the condition and its block are a scope of their own.
rule if_expr =
  | IfNoElse:   "if" if_then @precedence("return")
  | IfElse:     "if" if_then "else" block
  | IfElseIf:   "if" if_then "else" if_expr

rule if_then = IfThen: cond block @scope

// Match arms. An arm's body is read as a statement begins: a block-like
// body ends the arm, with or without a comma; any other needs one,
// except the last.
rule arms_opt =
  | ArmsNone:
  | Arms:     arm_list
  | ArmsLast: arm_list arm_last
  | ArmOnly:  arm_last

rule arm_list = arm+

rule arm =
  | ArmBlock:      outer_attrs_opt pat guard_opt EQ_ARROW GT block_like @scope
  | ArmBlockComma: outer_attrs_opt pat guard_opt EQ_ARROW GT block_like "," @scope
  | ArmExpr:       outer_attrs_opt pat guard_opt EQ_ARROW GT stmt_expr "," @scope

rule arm_last = ArmLast: outer_attrs_opt pat guard_opt EQ_ARROW GT stmt_expr @scope

rule guard_opt = guard?

rule guard = Guard: "if" expr

// ---- expressions: what every tier shares ----

// An operand that is neither block-like nor a struct literal.
rule atom =
  | Lit:        literal
  | PathExpr:   p:expr_path @style(inherit, p)
  | MacroCall:  p:plain_path b:BANG open:"(" tts ")" @fold(list, open) @style(macro, p, b) @ns(macro, p) @expands
  | MacroIndex: p:plain_path b:BANG open:"[" tts "]" @fold(list, open) @style(macro, p, b) @ns(macro, p) @expands
  | Unit:       "(" ")" @fold(list)
  | Paren:      "(" elem ")" @fold(list)
  | TupleOne:   "(" elem "," ")" @fold(list)
  | Tuple:      "(" elem "," expr_list ")" @fold(list)
  | TupleTrail: "(" elem "," expr_list "," ")" @fold(list)
  | ArrayEmpty: "[" "]" @fold(list)
  | Array:      "[" expr_list "]" @fold(list)
  | ArrayTrail: "[" expr_list "," "]" @fold(list)
  | ArrayRepeat: "[" elem ";" expr "]" @fold(list)
  | Continue:   "continue"
  | ContinueLabel: "continue" l:lifetime @style(label, l) @ref(l) @ns(label)
  | Underscore: "_"

rule expr_list = elem+ % ","

// An element of a call's arguments, an array or a tuple: outer
// attributes may come before it (`f(#[cfg(unix)] fd)`), as the Reference
// allows there.
rule elem =
  | Elem:     expr
  | AttrElem: outer_attrs expr

rule outer_attrs = outer_attr+

rule args_opt =
  | ArgsNone:
  | Args:      expr_list
  | ArgsTrail: expr_list ","

rule struct_lit =
  | StructLit:      p:expr_path open:"{" struct_fields_opt "}" @fold(list, open) @style(type, p)

rule struct_fields_opt =
  | StructFieldsNone:
  | StructFields:      struct_field_list
  | StructFieldsTrail: struct_field_list ","
  | StructFieldsBase:  struct_field_list "," DOT_DOT DOT expr
  | StructFieldsOnlyBase: DOT_DOT DOT expr
  | StructFieldsRest:  struct_field_list "," DOT_DOT DOT
  | StructFieldsOnlyRest: DOT_DOT DOT

rule struct_field_list = struct_field+ % ","

rule struct_field =
  | FieldInit:      outer_attrs_opt name COLON expr
  | FieldIndexInit: outer_attrs_opt INT COLON expr
  | FieldShort:     outer_attrs_opt n:name @ref(n, escaping)

rule closure_params =
  | ClosureNoParams: PIPE_PIPE PIPE
  | ClosureParams:   PIPE closure_param_list PIPE
  | ClosureParamsTrail: PIPE closure_param_list "," PIPE

rule closure_param_list = closure_param+ % ","

rule closure_param =
  | ClosureParam:      outer_attrs_opt pat_no_alt
  | ClosureParamTyped: outer_attrs_opt p:pat_no_alt COLON t:type @typed(p, t)

rule closure_head =
  | ClosureHead:      closure_params
  | MoveClosure:      "move" closure_params
  | AsyncClosure:     "async" closure_params
  | AsyncMoveClosure: "async" "move" closure_params

// What follows a `.`: a field, a tuple index (or two, read as one float:
// `x.0.1`), `await`, or a method call.
rule member =
  | MemberField:     name @precedence(DOT)
  | MemberIndex:     INT
  | MemberIndex2:    FLOAT
  | MemberAwait:     "await"
  | MemberMethod:    n:name open:"(" args_opt ")" @fold(list, open) @style(method, n)
  | MemberTurbofish: n:name path_sep generic_args open:"(" args_opt ")" @fold(list, open) @style(method, n)

// ---- expressions: the full tier ----

rule expr =
  | Atom:        a:atom @style(inherit, a)
  | StructExpr:  struct_lit
  | BlockLike:   block_like
  | Closure:     closure_head expr @precedence("return") @scope
  | ClosureRet:  closure_head MINUS_ARROW GT type_nb block @scope
  | Return:      "return" @precedence("return")
  | ReturnValue: "return" expr @precedence("return")
  | Break:       "break" @precedence("return")
  | BreakValue:  "break" expr @precedence("return")
  | BreakLabel:  "break" l:lifetime @precedence("return") @style(label, l) @ref(l) @ns(label)
  | BreakLabelValue: "break" l:lifetime expr @precedence("return") @style(label, l) @ref(l) @ns(label)
  | Member:      expr DOT member @precedence(DOT)
  | SplitMember: expr DOT FLOAT_DOT member @precedence(DOT)
  | Call:        c:expr open:"(" args_opt ")" @fold(list, open) @style(function, c)
  | Index:       expr open:"[" expr "]" @fold(list, open)
  | Try:         expr QMARK
  | Neg:         MINUS expr @precedence(BANG)
  | Not:         BANG expr
  | Deref:       STAR expr @precedence(BANG)
  | Ref:         amp expr @precedence(BANG)
  | RefMut:      amp "mut" expr @precedence(BANG)
  | RawConst:    amp KW_RAW "const" expr @precedence(BANG)
  | RawMut:      amp KW_RAW "mut" expr @precedence(BANG)
  | Cast:        expr "as" type_nb @precedence("as")
  | Mul:         expr STAR expr
  | Div:         expr SLASH expr
  | Rem:         expr PERCENT expr
  | Add:         expr PLUS expr
  | Sub:         expr MINUS expr
  | Shl:         expr LT_SHL shl_second expr @precedence(LT_SHL)
  | Shr:         expr GT_SHR GT expr @precedence(GT_SHR)
  | BitAnd:      expr AMP expr
  | BitXor:      expr CARET expr
  | BitOr:       expr PIPE expr
  | Eq:          expr EQ_EQ EQ expr @precedence(EQ_EQ)
  | Ne:          expr BANG_EQ EQ expr @precedence(BANG_EQ)
  | LtExpr:      expr LT expr
  | GtExpr:      expr GT expr
  | Le:          expr LT_LE EQ expr @precedence(LT_LE)
  | Ge:          expr GT_GE EQ expr @precedence(GT_GE)
  | And:         expr AMP_AMP amp_second expr @precedence(AMP_AMP)
  | Or:          expr PIPE_PIPE pipe_second expr @precedence(PIPE_PIPE)
  | Range:       expr DOT_DOT DOT expr @precedence(DOT_DOT)
  | RangeIncl:   expr DOT_DOT DOT_EQ EQ expr @precedence(DOT_DOT)
  | RangeFrom:   expr DOT_DOT DOT @precedence("return")
  | RangeTo:     DOT_DOT DOT expr @precedence(DOT_DOT)
  | RangeToIncl: DOT_DOT DOT_EQ EQ expr @precedence(DOT_DOT)
  | RangeFull:   DOT_DOT DOT @precedence("return")
  | Assign:      expr EQ expr
  | AddAssign:   expr PLUS_EQ EQ expr @precedence(PLUS_EQ)
  | SubAssign:   expr MINUS_EQ EQ expr @precedence(MINUS_EQ)
  | MulAssign:   expr STAR_EQ EQ expr @precedence(STAR_EQ)
  | DivAssign:   expr SLASH_EQ EQ expr @precedence(SLASH_EQ)
  | RemAssign:   expr PERCENT_EQ EQ expr @precedence(PERCENT_EQ)
  | XorAssign:   expr CARET_EQ EQ expr @precedence(CARET_EQ)
  | AndAssign:   expr AMP_EQ EQ expr @precedence(AMP_EQ)
  | OrAssign:    expr PIPE_EQ EQ expr @precedence(PIPE_EQ)
  | ShlAssign:   expr LT_SHLEQ LT_LE EQ expr @precedence(LT_SHLEQ)
  | ShrAssign:   expr GT_SHREQ GT_GE EQ expr @precedence(GT_SHREQ)

// The second character of `<<`, `&&` and `||`: the character after it
// can make it a token of another kind (`a <<<T>::C`, `a &&&b`, `a |||x| x`).
rule shl_second = | ShlSecond: LT | ShlSecondShl: LT_SHL
rule amp_second = | AndSecond: AMP | AndSecondAnd: AMP_AMP
rule pipe_second = | OrSecond: PIPE | OrSecondOr: PIPE_PIPE

// ---- expressions: the condition tier ----

rule cond =
  | CAtom:        a:atom @style(inherit, a)
  | CBlockLike:   block_like
  | CLet:         "let" p:pat EQ c:cond @precedence(AMP_AMP) @defer(p, c)
  | CClosure:     closure_head cond @precedence("return") @scope
  | CClosureRet:  closure_head MINUS_ARROW GT type_nb block @scope
  | CReturn:      "return" @precedence(DOT_DOT)
  | CReturnValue: "return" cond @precedence("return")
  | CBreak:       "break" @precedence(DOT_DOT)
  | CBreakValue:  "break" cond @precedence("return")
  | CBreakLabel:  "break" l:lifetime @precedence(DOT_DOT) @style(label, l) @ref(l) @ns(label)
  | CBreakLabelValue: "break" l:lifetime cond @precedence("return") @style(label, l) @ref(l) @ns(label)
  | CMember:      cond DOT member @precedence(DOT)
  | CSplitMember: cond DOT FLOAT_DOT member @precedence(DOT)
  | CCall:        c:cond open:"(" args_opt ")" @fold(list, open) @style(function, c)
  | CIndex:       cond open:"[" expr "]" @fold(list, open)
  | CTry:         cond QMARK
  | CNeg:         MINUS cond @precedence(BANG)
  | CNot:         BANG cond
  | CDeref:       STAR cond @precedence(BANG)
  | CRef:         amp cond @precedence(BANG)
  | CRefMut:      amp "mut" cond @precedence(BANG)
  | CRawConst:    amp KW_RAW "const" cond @precedence(BANG)
  | CRawMut:      amp KW_RAW "mut" cond @precedence(BANG)
  | CCast:        cond "as" type_nb @precedence("as")
  | CMul:         cond STAR cond
  | CDiv:         cond SLASH cond
  | CRem:         cond PERCENT cond
  | CAdd:         cond PLUS cond
  | CSub:         cond MINUS cond
  | CShl:         cond LT_SHL shl_second cond @precedence(LT_SHL)
  | CShr:         cond GT_SHR GT cond @precedence(GT_SHR)
  | CBitAnd:      cond AMP cond
  | CBitXor:      cond CARET cond
  | CBitOr:       cond PIPE cond
  | CEq:          cond EQ_EQ EQ cond @precedence(EQ_EQ)
  | CNe:          cond BANG_EQ EQ cond @precedence(BANG_EQ)
  | CLt:          cond LT cond
  | CGt:          cond GT cond
  | CLe:          cond LT_LE EQ cond @precedence(LT_LE)
  | CGe:          cond GT_GE EQ cond @precedence(GT_GE)
  | CAnd:         cond AMP_AMP amp_second cond @precedence(AMP_AMP)
  | COr:          cond PIPE_PIPE pipe_second cond @precedence(PIPE_PIPE)
  | CRange:       cond DOT_DOT DOT cond @precedence(DOT_DOT)
  | CRangeIncl:   cond DOT_DOT DOT_EQ EQ cond @precedence(DOT_DOT)
  | CRangeFrom:   cond DOT_DOT DOT @precedence(DOT_DOT)
  | CRangeTo:     DOT_DOT DOT cond @precedence(DOT_DOT)
  | CRangeToIncl: DOT_DOT DOT_EQ EQ cond @precedence(DOT_DOT)
  | CRangeFull:   DOT_DOT DOT @precedence(DOT_DOT)
  | CAssign:      cond EQ cond
  | CAddAssign:   cond PLUS_EQ EQ cond @precedence(PLUS_EQ)
  | CSubAssign:   cond MINUS_EQ EQ cond @precedence(MINUS_EQ)
  | CMulAssign:   cond STAR_EQ EQ cond @precedence(STAR_EQ)
  | CDivAssign:   cond SLASH_EQ EQ cond @precedence(SLASH_EQ)
  | CRemAssign:   cond PERCENT_EQ EQ cond @precedence(PERCENT_EQ)
  | CXorAssign:   cond CARET_EQ EQ cond @precedence(CARET_EQ)
  | CAndAssign:   cond AMP_EQ EQ cond @precedence(AMP_EQ)
  | COrAssign:    cond PIPE_EQ EQ cond @precedence(PIPE_EQ)
  | CShlAssign:   cond LT_SHLEQ LT_LE EQ cond @precedence(LT_SHLEQ)
  | CShrAssign:   cond GT_SHREQ GT_GE EQ cond @precedence(GT_SHREQ)

// ---- expressions: the statement tier ----

rule stmt_expr =
  | SAtom:        a:atom @style(inherit, a)
  | SStructExpr:  struct_lit
  | SBlockMember: block_like DOT member @precedence(DOT)
  | SBlockSplitMember: block_like DOT FLOAT_DOT member @precedence(DOT)
  | SBlockTry:    block_like QMARK
  | SClosure:     closure_head expr @precedence("return") @scope
  | SClosureRet:  closure_head MINUS_ARROW GT type_nb block @scope
  | SReturn:      "return" @precedence("return")
  | SReturnValue: "return" expr @precedence("return")
  | SBreak:       "break" @precedence("return")
  | SBreakValue:  "break" expr @precedence("return")
  | SBreakLabel:  "break" l:lifetime @precedence("return") @style(label, l) @ref(l) @ns(label)
  | SBreakLabelValue: "break" l:lifetime expr @precedence("return") @style(label, l) @ref(l) @ns(label)
  | SMember:      stmt_expr DOT member @precedence(DOT)
  | SSplitMember: stmt_expr DOT FLOAT_DOT member @precedence(DOT)
  | SCall:        c:stmt_expr open:"(" args_opt ")" @fold(list, open) @style(function, c)
  | SIndex:       stmt_expr open:"[" expr "]" @fold(list, open)
  | STry:         stmt_expr QMARK
  | SNeg:         MINUS expr @precedence(BANG)
  | SNot:         BANG expr
  | SDeref:       STAR expr @precedence(BANG)
  | SRef:         amp expr @precedence(BANG)
  | SRefMut:      amp "mut" expr @precedence(BANG)
  | SRawConst:    amp KW_RAW "const" expr @precedence(BANG)
  | SRawMut:      amp KW_RAW "mut" expr @precedence(BANG)
  | SCast:        stmt_expr "as" type_nb @precedence("as")
  | SMul:         stmt_expr STAR expr
  | SDiv:         stmt_expr SLASH expr
  | SRem:         stmt_expr PERCENT expr
  | SAdd:         stmt_expr PLUS expr
  | SSub:         stmt_expr MINUS expr
  | SShl:         stmt_expr LT_SHL shl_second expr @precedence(LT_SHL)
  | SShr:         stmt_expr GT_SHR GT expr @precedence(GT_SHR)
  | SBitAnd:      stmt_expr AMP expr
  | SBitXor:      stmt_expr CARET expr
  | SBitOr:       stmt_expr PIPE expr
  | SEq:          stmt_expr EQ_EQ EQ expr @precedence(EQ_EQ)
  | SNe:          stmt_expr BANG_EQ EQ expr @precedence(BANG_EQ)
  | SLt:          stmt_expr LT expr
  | SGt:          stmt_expr GT expr
  | SLe:          stmt_expr LT_LE EQ expr @precedence(LT_LE)
  | SGe:          stmt_expr GT_GE EQ expr @precedence(GT_GE)
  | SAnd:         stmt_expr AMP_AMP amp_second expr @precedence(AMP_AMP)
  | SOr:          stmt_expr PIPE_PIPE pipe_second expr @precedence(PIPE_PIPE)
  | SRange:       stmt_expr DOT_DOT DOT expr @precedence(DOT_DOT)
  | SRangeIncl:   stmt_expr DOT_DOT DOT_EQ EQ expr @precedence(DOT_DOT)
  | SRangeFrom:   stmt_expr DOT_DOT DOT @precedence("return")
  | SRangeTo:     DOT_DOT DOT expr @precedence(DOT_DOT)
  | SRangeToIncl: DOT_DOT DOT_EQ EQ expr @precedence(DOT_DOT)
  | SRangeFull:   DOT_DOT DOT @precedence("return")
  | SAssign:      stmt_expr EQ expr
  | SAddAssign:   stmt_expr PLUS_EQ EQ expr @precedence(PLUS_EQ)
  | SSubAssign:   stmt_expr MINUS_EQ EQ expr @precedence(MINUS_EQ)
  | SMulAssign:   stmt_expr STAR_EQ EQ expr @precedence(STAR_EQ)
  | SDivAssign:   stmt_expr SLASH_EQ EQ expr @precedence(SLASH_EQ)
  | SRemAssign:   stmt_expr PERCENT_EQ EQ expr @precedence(PERCENT_EQ)
  | SXorAssign:   stmt_expr CARET_EQ EQ expr @precedence(CARET_EQ)
  | SAndAssign:   stmt_expr AMP_EQ EQ expr @precedence(AMP_EQ)
  | SOrAssign:    stmt_expr PIPE_EQ EQ expr @precedence(PIPE_EQ)
  | SShlAssign:   stmt_expr LT_SHLEQ LT_LE EQ expr @precedence(LT_SHLEQ)
  | SShrAssign:   stmt_expr GT_SHREQ GT_GE EQ expr @precedence(GT_SHREQ)
